<?xml version="1.0" encoding="utf-8"?>
<!-- Used ONLY by the DebugLocalNuGet configuration (Directory.Build.props sets RestoreConfigFile to this
     file): template/engine development against the monorepo's local-nuget-feed/ folder. Same source mapping
     as nuget.config, but Kandra.* / KandraWms.* come from the local folder ONLY, so nothing published on
     nuget.org (or the public feed) can win the 0.3.*-* float. Irrelevant to anyone adopting the template. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="KandraLocal" value="../../../local-nuget-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="KandraLocal">
      <package pattern="Kandra.*" />
      <package pattern="KandraWms.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
