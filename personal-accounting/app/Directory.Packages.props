<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Central Package Management rejects floating versions unless opted in - needed for
         $(KandraCoreVersion)'s DebugLocalNuGet float (see Directory.Build.props). -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Mapperly (Apache-2.0): compile-time entity <-> Dto mapping source generator, build-time only
         (PrivateAssets="all" + ExcludeAssets="runtime" at every use; its attributes are [Conditional]). -->
    <PackageVersion Include="Riok.Mapperly" Version="4.3.1" />
    <!-- FluentValidation -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Authorization" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" />
    <!-- Entity Framework Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.11" />
    <!-- PostgreSQL -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- SQLite - explicit override of the SQLitePCLRaw.lib.e_sqlite3 transitive vulnerability
         (GHSA-2m69-gcr7-jv3q) pulled in by Microsoft.Data.Sqlite. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />

    <!-- Kandra platform packages (nugets.kandra.tech) - one entry per Kandra.* project
         directly PackageReference'd from a project below; everything else (Kandra.Constants, Kandra.Enums,
         Kandra.DtoCommon, Kandra.Forms, Kandra.Persistence.Abstractions, Kandra.Application.Abstractions, ...)
         comes in transitively via each of these packages' own nuspec dependencies. -->
    <PackageVersion Include="Kandra.Api.Lib" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Application" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Attributes" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.ClientLib.Common" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.ClientLib.MudBlazor" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.DataImport" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Domain" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.EntityOperations" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.Api" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.ClientLib" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.Constants" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.DataProcessorRegistry" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.Di.Application" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.Di.Persistence" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.EfConfig" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.EntityOperations" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.Equality" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.Printing" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.RegisterTransactions.Application" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.RegisterTransactions.Persistence" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.TypeRegistry" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Generators.Ui.Blazor" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Localization" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Persistence" Version="$(KandraCoreVersion)" />
    <PackageVersion Include="Kandra.Validators" Version="$(KandraCoreVersion)" />
  </ItemGroup>
</Project>
