<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PersonalAccounting.Application\PersonalAccounting.Application.csproj" />
    <ProjectReference Include="..\PersonalAccounting.Persistence.Databases\PersonalAccounting.Persistence.Databases.csproj" />
    <ProjectReference Include="..\PersonalAccounting.Client.MudBlazor\PersonalAccounting.Client.MudBlazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Kandra.Api.Lib" />
    <PackageReference Include="Kandra.Generators.Api" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Update="db\.placeholder">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
