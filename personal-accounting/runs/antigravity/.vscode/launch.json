{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PersonalAccounting.WebApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build PersonalAccounting.WebApi",
      "program": "${workspaceFolder}/src/PersonalAccounting.WebApi/bin/Debug/net10.0/PersonalAccounting.WebApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/PersonalAccounting.WebApi",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        // Launching the built DLL (not the C# Dev Kit "dotnet" type) does not read launchSettings.json,
        // so this mirrors its "PersonalAccounting.WebApi" profile. The "dotnet" type was avoided on
        // purpose: for a host that serves a Blazor WASM client it adds a browser-debugging attach step
        // that fails with "Could not find any debuggable target" while Edge/Chrome is already running.
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7225;http://localhost:5225"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)",
        "uriFormat": "%s"
      }
    },
    {
      "name": "PersonalAccounting.WebApi (Swagger)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build PersonalAccounting.WebApi",
      "program": "${workspaceFolder}/src/PersonalAccounting.WebApi/bin/Debug/net10.0/PersonalAccounting.WebApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/PersonalAccounting.WebApi",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7225;http://localhost:5225"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
