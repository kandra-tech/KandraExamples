{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Provider": "Sqlite",
  "_Provider": "SqlServer",
  "__Provider": "PostgreSql",
  "ConnectionStrings": {
    "Sqlite": "Data Source = ./db/personalaccounting.db",
    "SqlServer": "Data Source=(LocalDb)\\MSSQLLocalDB;Initial Catalog=PersonalAccounting;Integrated Security=True",
    "PostgreSql": "Host=localhost; Database=personalaccounting; Username=postgres; Password=postgres"
  },
  "JwtOptions": {
    "Issuer": "PersonalAccounting",
    "Audience": "https://localhost:7220",
    "Expires": "1.00:00:00",
    "RefreshExpires": "14.00:00:00"
  },
  "ReportResultCache": {
    "Ttl": "00:15:00",
    "MaxTotalSizeBytes": 52428800
  },
  "FeatureManagement": {
    "ChangeEventPayload": true
  },
  "BlobStorage": {
    "DefaultUploadTtl": "00:30:00",
    "DefaultTombstoneGracePeriod": "00:15:00",
    "GcInterval": "00:05:00",
    "MaxUploadSizeBytes": 104857600,
    "InlineStorageThresholdBytes": 8192
  }
}
