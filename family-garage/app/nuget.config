<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Kandra's public feed: anonymous, no token. -->
    <add key="Kandra" value="https://nugets.kandra.tech/index.json" />
  </packageSources>
  <!-- Package source mapping: NuGet does NOT prefer sources in the order listed - without this it takes the
       best version match from ANY source, so anyone publishing a "Kandra.Domain" with a higher version on
       nuget.org would win the restore (dependency confusion). With it, Kandra.* / KandraWms.* restore only
       from the Kandra feed and everything else only from nuget.org. Add your own configuration's package
       prefix to the Kandra source only if you publish it to a private feed of your own. -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Kandra">
      <package pattern="Kandra.*" />
      <package pattern="KandraWms.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
