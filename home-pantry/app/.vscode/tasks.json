{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "type": "shell",
      "command": "dotnet",
      "args": ["restore", " HomePantry.slnx"],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build solution",
      "type": "shell",
      "command": "dotnet",
      "args": ["build", "HomePantry.slnx"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "test",
      "type": "shell",
      "command": "dotnet",
      "args": ["test", "HomePantry.slnx"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "watch HomePantry.WebApi",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "watch",
        "run",
        "--project",
        "src/HomePantry.WebApi",
        "--launch-profile",
        "HomePantry.WebApi"
      ],
      "problemMatcher": "$msCompile",
      "isBackground": true,
      "group": "build"
    },
    {
      "label": "build HomePantry.WebApi",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/HomePantry.WebApi/HomePantry.WebApi.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build HomePantry.Client.MudBlazor",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/src/HomePantry.Client.MudBlazor/HomePantry.Client.MudBlazor.csproj"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build HomePantry",
      "dependsOn": [
        "build HomePantry.WebApi",
        "build HomePantry.Client.MudBlazor"
      ],
      "dependsOrder": "parallel",
      "group": "build"
    },
    {
      "label": "Run Dotnet HomePantry.WebApi",
      "dependsOn": "build HomePantry.WebApi",
      "type": "shell",
      "command": "dotnet",
      "args": ["run",
        "--project",
        "src/HomePantry.WebApi",
        "--launch-profile",
        "HomePantry.WebApi"]
    }
  ]
}
